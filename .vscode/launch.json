        },
        {
            "name": "GUI Service",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/gui_service/cmd"
        },
        {
            "name": "Config Service",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/config_service/cmd"
        },
        {
            "name": "TSN Service",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/tsn_service/cmd"
        },
        {
            "name": "Main Service",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main_service/cmd"
        },
        {
            "name": "Test Plugins",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/config_service/cmd/test_plugins"
